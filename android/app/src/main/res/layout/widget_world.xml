<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="Add cities in WAKE11 → Clock" android:textColor="#C8CDD2" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#C8CDD2" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_time1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#C8CDD2" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#C8CDD2" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_time3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
