<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:textColor="#FFFFFF" android:textSize="56sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM"
        android:textColor="#C8CDD2" android:textSize="15sp" />
    <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FF8A3D" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
