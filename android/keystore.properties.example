# Copy to keystore.properties (same folder) and fill in. keystore.properties is git-ignored.
# Keep the .jks file and these passwords backed up privately: without them you cannot install
# updates over the released app (Android requires the same signing key).
storeFile=C:/Users/YOUR_NAME/.epoch/epoch-release.jks
storePassword=CHANGE_ME
keyAlias=epoch
keyPassword=CHANGE_ME
